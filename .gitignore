# This is the public repository for the paper. It tracks `code/` and
# `formalisation/` only. Everything else in the working tree is private working
# material and is listed here.
/paper/
/literature/
/project_management/
/paper_reviews/
/CLAUDE.md

# Computations the paper quotes no number from. Kept on disk, not published.
/code/legacy/

# Working files of the formalisation, outside the build and the audit. Kept on
# disk, not published.
/formalisation/legacy/

# The manuscript is never committed here, whatever directory it is copied into.
main.tex
main.pdf
STATE.txt

# Staged output of an interrupted or failed run of a script under code/gp or
# code/sage. A clean run moves the file onto code/data/ and leaves nothing behind.
/code/data/*.partial

.DS_Store
.claude/
