########################################################################
# code/data/p5.out -- pi-descent at p = 5 for E : y^2 = x^3 - 56x
# Two runs: (1) GRH-conditional (the board's Appendix A setting),
#           (2) unconditional (no SetClassGroupBounds, ClassGroup Proof:="Full").
# Both give BOUND b = 2 = rank E(Q), hence Sha(E/Q)[5^oo] = 0.
########################################################################

===================== RUN 1 : GRH-CONDITIONAL =====================
# command : nice -n 10 timeout 300 /usr/local/bin/magma -b pp:=5 curve:=0,0,0,-56,0 grh:=on rk:=2 tag:=A1-reproduce-GRH $HOME/fsr2_descent/pi_descent.m
# magma   : V2.29-9
# date    : 2026-08-20T15:02:50Z (UTC), host remote-host, timeout 300s, nice 10
================ p = 5 ================
# pi_descent.m   Magma V2.29-9
# curve  = [ 0, 0, 0, -56, 0 ]
# GRH    = on   (SetClassGroupBounds("GRH") APPLIED)
# ram    = auto   optrep = off   rk = 2   tag = A1-reproduce-GRH
# E      = Elliptic Curve defined by y^2 = x^3 - 56*x over Rational Field
# minimal model [ 0, 0, 0, -56, 0 ], conductor 12544, disc 11239424
# CM     = true (disc -4)
# bad primes of E : [ 2, 7 ] ; S-primes (bad and p) : [ 2, 5, 7 ]
kernel polys of degree 2 : 2
F = K(E[pi]) : [F:Q] = 8
# field construction [0.030s]
T : order 5
#Gal(F/K) = 4  (expected 4)
chi values : [ 1, 4, 2, 3 ]
# chi faithful : true   (faithful => E(K)[p] = 0)
# sigma0 candidates (chi(sigma0) a primitive root mod 5) : 2 of 4
# MaximalOrder(F : Ramification := [ 2, 5, 7 ]) done [0.030s]
# disc(F) = 246727835648000
Cl(F) = [ 20 ]   [0.220s]  (GRH: SetClassGroupBounds("GRH"))
#S = 4
dim_F5 F(S,5) = 8   [0.010s]

sigma with chi = 4 :
   eigenvalue 1 : dim 5
   eigenvalue 4 : dim 3

sigma with chi = 2 :
   eigenvalue 1 : dim 4
   eigenvalue 2 : dim 2
   eigenvalue 3 : dim 1
   eigenvalue 4 : dim 1

sigma with chi = 3 :
   eigenvalue 1 : dim 4
   eigenvalue 2 : dim 1
   eigenvalue 3 : dim 2
   eigenvalue 4 : dim 1

---------------- SUMMARY ----------------
curve [ 0, 0, 0, -56, 0 ]   p = 5   GRH = on
[F:Q] = 8   #Gal(F/K) = 4   chi faithful = true   Cl(F) = [ 20 ]
dim F(S,5) = 8
sigma0 with chi(sigma0) = 2 (primitive root mod 5)
dim chi-eigenspace      = 2
dim chi^{-1}-eigenspace = 1
BOUND b = max = 2        (s <= b, convention-free)
rank E(Q) = 2, so s >= 2 always; internal check requires b >= 2
INTERNAL CHECK b >= rank E(Q) : PASS
CONCLUSION : s = 2, so Sha(E/K)[phi] = 0, Sha(E/K)[5] = 0,
             hence Sha(E/Q)[5^oo] = 0.   [GRH-CONDITIONAL]
---------------- END --------------------
# EXIT   : 0

===================== RUN 2 : UNCONDITIONAL ======================
# command : nice -n 10 timeout 300 /usr/local/bin/magma -b pp:=5 curve:=0,0,0,-56,0 grh:=off rk:=2 tag:=A4-unconditional $HOME/fsr2_descent/pi_descent.m
# magma   : V2.29-9
# date    : 2026-08-20T15:03:36Z (UTC), host remote-host, timeout 300s, nice 10
================ p = 5 ================
# pi_descent.m   Magma V2.29-9
# curve  = [ 0, 0, 0, -56, 0 ]
# GRH    = off   (SetClassGroupBounds("GRH") NOT applied)
# ram    = auto   optrep = off   rk = 2   tag = A4-unconditional
# E      = Elliptic Curve defined by y^2 = x^3 - 56*x over Rational Field
# minimal model [ 0, 0, 0, -56, 0 ], conductor 12544, disc 11239424
# CM     = true (disc -4)
# bad primes of E : [ 2, 7 ] ; S-primes (bad and p) : [ 2, 5, 7 ]
kernel polys of degree 2 : 2
F = K(E[pi]) : [F:Q] = 8
# field construction [0.040s]
T : order 5
#Gal(F/K) = 4  (expected 4)
chi values : [ 1, 4, 2, 3 ]
# chi faithful : true   (faithful => E(K)[p] = 0)
# sigma0 candidates (chi(sigma0) a primitive root mod 5) : 2 of 4
# MaximalOrder(F : Ramification := [ 2, 5, 7 ]) done [0.030s]
# disc(F) = 246727835648000
Cl(F) = [ 20 ]   [3.140s]  (UNCONDITIONAL: Proof := "Full", Minkowski bound 99208)
#S = 4
dim_F5 F(S,5) = 8   [0.000s]

sigma with chi = 4 :
   eigenvalue 1 : dim 5
   eigenvalue 4 : dim 3

sigma with chi = 2 :
   eigenvalue 1 : dim 4
   eigenvalue 2 : dim 2
   eigenvalue 3 : dim 1
   eigenvalue 4 : dim 1

sigma with chi = 3 :
   eigenvalue 1 : dim 4
   eigenvalue 2 : dim 1
   eigenvalue 3 : dim 2
   eigenvalue 4 : dim 1

---------------- SUMMARY ----------------
curve [ 0, 0, 0, -56, 0 ]   p = 5   GRH = off
[F:Q] = 8   #Gal(F/K) = 4   chi faithful = true   Cl(F) = [ 20 ]
dim F(S,5) = 8
sigma0 with chi(sigma0) = 2 (primitive root mod 5)
dim chi-eigenspace      = 2
dim chi^{-1}-eigenspace = 1
BOUND b = max = 2        (s <= b, convention-free)
rank E(Q) = 2, so s >= 2 always; internal check requires b >= 2
INTERNAL CHECK b >= rank E(Q) : PASS
CONCLUSION : s = 2, so Sha(E/K)[phi] = 0, Sha(E/K)[5] = 0,
             hence Sha(E/Q)[5^oo] = 0.   [UNCONDITIONAL]
---------------- END --------------------
# EXIT   : 0
